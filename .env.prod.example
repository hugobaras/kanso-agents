# Production — copier en .env.prod (jamais commité) et remplir chaque valeur.
# Générer les secrets : openssl rand -base64 48

# ---- Domaines (DNS A/AAAA de chacun, et de www.<domaine>, vers l'IP du serveur) ----
DOMAIN_SOLUTIONS=kanso-solutions.fr
DOMAIN_ASSISTANT=kanso-assistant.fr
DOMAIN_SITE=kanso-site.fr
DOMAIN_PORTAIL=kanso-portail.fr
DOMAIN_API=api.kanso-assistant.fr
ACME_EMAIL=tech@kanso.fr

# ---- Secrets (à conserver aussi hors du serveur, dans le gestionnaire de mots de passe) ----
KANSO_MASTER_KEY=
KANSO_BACKUP_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://kanso:<POSTGRES_PASSWORD>@db:5432/kanso

# ---- E-mail (prestataire SMTP UE ; SPF, DKIM et DMARC configurés, voir docs/runbooks/production.md) ----
KANSO_SMTP_URL=smtps://user:pass@ssl0.ovh.net:465
KANSO_MAIL_FROM=Kanso <no-reply@kanso.fr>
KANSO_SALES_EMAIL=bonjour@kanso.fr

# ---- Stockage objet OVH (pièces du Portail) + copie des sauvegardes ----
KANSO_S3_BUCKET=kanso-pieces
KANSO_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
KANSO_S3_REGION=gra
KANSO_S3_ACCESS_KEY=
KANSO_S3_SECRET_KEY=
KANSO_BACKUP_S3_URI=s3://kanso-sauvegardes/db

# ---- Paiement (clés live après validation du compte Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=1

# ---- IA ----
MISTRAL_API_KEY=
# Laisser vide tant que l'avenant IA et la non-conservation Mistral ne sont pas signés.
KANSO_PORTAIL_AI_MODE=
