# ---- Core ---------------------------------------------------------------
KANSO_ENV=local                       # local | staging | production
KANSO_MASTER_KEY=replace-me-local-only-min-32-chars-long!!
DATABASE_URL=postgres://kanso:kanso@127.0.0.1:5433/kanso
PORT=3000

# Public URLs (e-mail links, CORS, widget snippet)
KANSO_APP_URL=http://localhost:3001   # web app (Next.js)
KANSO_PUBLIC_URL=http://localhost:3000 # API (widget script + widget API)
# Extra origins allowed on the credentialed API (comma-separated)
# KANSO_CORS_ORIGINS=

# ---- Web app (apps/web) ----------------------------------------------------
# INTERNAL_API_URL=http://localhost:3000   # where Next.js proxies /api/*
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---- E-mail ------------------------------------------------------------------
# Empty = console transport: e-mails are logged and stored in mail_outbox
# (readable at /api/dev/mails outside production).
# KANSO_SMTP_URL=smtps://user:pass@ssl0.ovh.net:465
# KANSO_MAIL_FROM=Kanso <no-reply@kanso.fr>
# Receives custom-integration and website quote requests
# KANSO_SALES_EMAIL=bonjour@kanso.fr

# ---- Billing (Stripe, test mode first) ----------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_AUTOMATIC_TAX=1                  # once Stripe Tax is configured

# ---- LLM — Mistral EU ------------------------------------------------------------
# Without a key: heuristic engine (conversations) + offline extractor (documents).
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
# KANSO_MISTRAL_MODEL=ministral-8b-latest          # conversations
# KANSO_MISTRAL_EXTRACT_MODEL=mistral-small-latest # documents
# KANSO_LLM_HANDOFF=0                               # 1 = LLM-written closing message

# ---- Worker / storage ------------------------------------------------------------
KANSO_STORAGE_DIR=.data/storage
KANSO_POLL_MS=2000
# KANSO_SCHEDULER=1              # retention, trial e-mails, exports, purges
# KANSO_RETENTION_DRY_RUN=0
# KANSO_D2A_FORCE_MOCK=0
# KANSO_ALLOW_FINAL=0            # final accounting writes (never by default)

# ---- Sessions / limits ------------------------------------------------------------
KANSO_SESSION_TTL_MINUTES=30
# KANSO_RATE_LIMIT=1             # 0 disables rate limiting (tests only)

# ---- Legacy pilotes (pre-SaaS widget with data-tenant) ----------------------------
# KANSO_LEGACY_WIDGET=1
