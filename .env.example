KANSO_ENV=local
KANSO_MASTER_KEY=replace-me-local-only-min-32-chars-long!!
# Prod pilote: comma-separated partner site origins (no trailing slash)
# KANSO_CORS_ORIGINS=https://www.cabinet.example,https://cabinet.example
# KANSO_WORKER_STALE_MS=120000
# KANSO_PUBLIC_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://kanso:kanso@127.0.0.1:5433/kanso
KANSO_SESSION_TTL_MINUTES=30
# Soft cap € estimé / tenant / jour (alerte interne ; H-027)
KANSO_SOFT_CAP_EUR_PER_DAY=5
# P3 opt-in
KANSO_RAG_ENABLED=0
KANSO_ALLOW_FINAL=0
KANSO_WORKER_BOOTSTRAP=1
KANSO_WORKER_POLL=1
KANSO_WORKER_ONCE=0
KANSO_POLL_MS=2000
KANSO_STORAGE_DIR=.data/storage
KANSO_KNOWN_IBANS=FR7611111222223333444445555
PORT=3000
# Supabase cloud (projet "kanso" dédié — ne pas utiliser shapemax)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional live e2e (never required in CI)
KANSO_E2E_LIVE=0
# LLM — Mistral EU (P0-06). Sans clé → mock local.
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
# KANSO_MISTRAL_MODEL=mistral-small-latest
# Vérifier les modèles EU: GET $MISTRAL_BASE_URL/models
# Alertes e-mail: secret_ref tenant (SMTP). Exemple put-secret:
# {"host":"ssl0.ovh.net","port":"587","user":"...","pass":"...","from":"alerts@...","to":"ops@..."}
# Sans "host" → mode console (log JSON, utile en local)
