# Staging local « live-ready » (phase 10) — ne pas committer de secrets réels
KANSO_ENV=staging
PORT=3000

# Dev local Docker DB (ou basculer vers Supabase UE)
DATABASE_URL=postgres://kanso:kanso@127.0.0.1:5433/kanso
KANSO_MASTER_KEY=replace-me-local-only-min-32-chars-long!!

KANSO_SESSION_TTL_MINUTES=30
KANSO_SOFT_CAP_EUR_PER_DAY=5
KANSO_STORAGE_DIR=.data/storage
KANSO_KNOWN_IBANS=FR7611111222223333444445555

# Worker
KANSO_WORKER_BOOTSTRAP=0
KANSO_WORKER_POLL=1
KANSO_WORKER_ONCE=0
KANSO_POLL_MS=2000

# LLM live (Mistral EU) — Q3
MISTRAL_API_KEY=
# MISTRAL_API_BASE=https://api.mistral.ai  # ou endpoint EU si fourni

# Secrets SMTP : via admin-cli put-secret, pas ici
# put-secret demo-tenant alerts.intake_email '{"host":"...","port":"587","user":"...","pass":"...","from":"...","to":"..."}'
