{
  "name": "kanso",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @kanso/inbound-api dev",
    "eval:inbound": "tsx eval/inbound/run.mts",
    "eval:inbound:live": "tsx eval/inbound/run-live.mts",
    "eval:documents": "tsx eval/documents/run.mts",
    "eval:corpus": "tsx eval/documents/run-corpus.mts",
    "demo:reset": "bash scripts/demo-reset.sh",
    "smoke:partner": "bash scripts/smoke-partner-template.sh",
    "onboard:partner": "bash scripts/onboard-partner.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "tsx": "^4.20.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
